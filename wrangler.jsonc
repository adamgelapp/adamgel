{
  "name": "adamgel",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "main": "worker.mjs",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adamgel-comments",
      "database_id": "f10816c3-5655-4f92-9414-5dbdb4063b83"
    }
  ]
}